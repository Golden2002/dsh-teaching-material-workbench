{
  "name": "dsh-teaching-material-workbench",
  "version": "0.5.0",
  "description": "Evidence-gated teaching-material production workbench for DeepSeek Harness: page model, per-page editing and preview, handout/deck/storyboard/Manim export, PAEG language checks, layered gates, checks center, version history, rights audit and reproducibility.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "skills/",
    "tests/",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "community/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "PUBLISHING.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "plugin",
    "teaching",
    "instructional-design",
    "evidence",
    "quality-assurance"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
