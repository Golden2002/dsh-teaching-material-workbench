{
  "name": "dsh-teaching-material-workbench",
  "version": "0.2.4",
  "description": "Evidence-gated teaching-material production workbench for DeepSeek Harness: scaffold a case, bind primary sources, audit claim-level grounding and the knowledge map, generate a deterministic outline, run layered gates, audit rights and hash artifacts.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "skills/",
    "tests/",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "community/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "PUBLISHING.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "plugin",
    "teaching",
    "instructional-design",
    "evidence",
    "quality-assurance"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
